<?xml version="1.0" encoding="utf-8"?>
<!-- The native window uses the same near-black background as the Flutter
     theme, with a small board mark so startup never shows an unbranded
     white or pure-black rectangle. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/iw_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
